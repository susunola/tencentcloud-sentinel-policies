# restrict-security-group-cidr
# Blocks ACCEPT rules that expose critical ports to the public internet.
# Tencent Cloud security-group port values are strings and may be single ports,
# comma-separated ports, ranges, or all. The shared helper parses all forms.

import "tencentcloud-functions" as tc

param forbidden_ports default [22, 3389, 3306, 6379, 27017, 5432]
param unrestricted_cidrs default ["0.0.0.0/0", "::/0"]

all_rules = tc.find_security_group_rules()
violations = {}
for all_rules as key, sg_rule {
	cidr = sg_rule.cidr_block else null
	port = sg_rule.port else null
	action = sg_rule.action else "ACCEPT"

	if action is "ACCEPT" and cidr in unrestricted_cidrs and
		tc.port_matches_any(port, forbidden_ports) {
		msg = key + " allows " + tc.port_to_scheme(port) + " (" +
			string(port) +
			") from " +
			cidr +
			" - this is a critical security risk"
		violations[key] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
