# restrict-cdb-public-access
# Requires all TencentDB (MySQL) instances to disable public access (Wan).
# Database instances should ONLY be accessible from within the VPC.
# Publicly accessible databases are a top-tier security risk.

import "tfplan-functions" as plan

allDatabases = plan.find_resources("tencentcloud_mysql_instance")

violations = {}
for allDatabases as address, db {
	wan_status = plan.evaluate_attribute(db, "internet_service") else null

	# internet_service = 1 means public access is turned ON
	if wan_status is not null and wan_status is 1 {
		msg = address + " has public internet access enabled (internet_service=1). " +
			"Database instances must not be publicly accessible."
		violations[address] = msg
		print(msg)
	}
}

# Also check tencentcloud_redis_instance's wan_address_switch parameter.
# Note: "wan_ip" is not a real attribute of this resource in the current
# provider schema. The actual configurable field that controls public
# internet exposure is "wan_address_switch" (String, "open"/"close",
# default "close"); "wan_address" is only the computed IP once opened.
allRedis = plan.find_resources("tencentcloud_redis_instance")
for allRedis as address, redis {
	wan_switch = plan.evaluate_attribute(redis, "wan_address_switch") else null
	if wan_switch is "open" {
		msg = address + " has public internet access enabled (wan_address_switch=\"open\"). " +
			"Redis instances must not be publicly accessible."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
