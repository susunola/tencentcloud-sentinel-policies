# Common functions for use with the TencentCloud provider
# These helpers wrap common-functions with Tencent Cloud-specific
# resource discovery, tag handling, and security-group parsing.

import "tfplan-functions" as plan
import "tfplan/v2" as tfplan
import "strings"

### find_resources_with_standard_tags ###
find_resources_with_standard_tags = func(resource_types) {
	resources = filter tfplan.resource_changes as address, rc {
		rc.provider_name matches "(.*)tencentcloud$" and
			rc.type in resource_types and
			rc.mode is "managed" and
			(rc.change.actions contains "create" or rc.change.actions contains "update" or
				rc.change.actions contains "read" or
				rc.change.actions contains "no-op")
	}
	return resources
}

### find_security_group_rules ###
find_security_group_rules = func() {
	rules = {}

	sgs = plan.find_resources("tencentcloud_security_group")
	for sgs as address, sg {
		ingress = plan.find_blocks(sg, "ingress")
		for ingress as i, r {
			r["_parent_address"] = address
			r["_direction"] = "ingress"
			rules[address + ".ingress[" + string(i) + "]"] = r
		}
		egress = plan.find_blocks(sg, "egress")
		for egress as i, r {
			r["_parent_address"] = address
			r["_direction"] = "egress"
			rules[address + ".egress[" + string(i) + "]"] = r
		}
	}

	rule_sets = plan.find_resources("tencentcloud_security_group_rule_set")
	for rule_sets as address, rs {
		ingress_rules = plan.find_blocks(rs, "ingress")
		for ingress_rules as i, r {
			r["_parent_address"] = address
			r["_direction"] = "ingress"
			rules[address + ".ingress[" + string(i) + "]"] = r
		}
		egress_rules = plan.find_blocks(rs, "egress")
		for egress_rules as i, r {
			r["_parent_address"] = address
			r["_direction"] = "egress"
			rules[address + ".egress[" + string(i) + "]"] = r
		}
	}

	return rules
}

### port_matches ###
# Tencent Cloud security-group ports are strings: all, 22, 22,80, or 20-30.
# This helper returns true when one declared token contains target_port.
port_matches = func(port_value, target_port) {
	if port_value is null {
		return false
	}

	port_text = string(port_value)
	if port_text is "all" or port_text is "ALL" {
		return true
	}

	matched = false
	port_tokens = strings.split(port_text, ",")
	for port_tokens as _, token {
		if token is string(target_port) {
			matched = true
		}

		range_parts = strings.split(token, "-")
		if length(range_parts) is 2 {
			start_port = int(range_parts[0])
			end_port = int(range_parts[1])
			if target_port >= start_port and target_port <= end_port {
				matched = true
			}
		}
	}
	return matched
}

port_matches_any = func(port_value, target_ports) {
	if port_value is null {
		return true
	}
	if string(port_value) is "all" or string(port_value) is "ALL" {
		return true
	}

	matched = false
	for target_ports as _, target_port {
		if port_matches(port_value, target_port) {
			matched = true
		}
	}
	return matched
}

### validate_cidr_not_open ###
validate_cidr_not_open = func(cidr) {
	if cidr is null {
		return false
	}
	return cidr is not "0.0.0.0/0"
}

### port_to_scheme ###
port_to_scheme = func(port) {
	case string(port) {
		when "22":
			return "SSH"
		when "3389":
			return "RDP"
		when "80":
			return "HTTP"
		when "443":
			return "HTTPS"
		when "3306":
			return "MySQL"
		when "5432":
			return "PostgreSQL"
		when "6379":
			return "Redis"
		when "27017":
			return "MongoDB"
		else:
			return "Port " + string(port)
	}
}
