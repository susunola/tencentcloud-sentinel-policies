# require-cdb-audit-log
# Requires every declared MySQL audit-service resource to record audit events
# and retain them for at least the configured period. The provider models this
# as a separate tencentcloud_mysql_audit_service resource, not an attribute on
# tencentcloud_mysql_instance.

import "tfplan-functions" as plan

param min_audit_log_retention_days default 30

allAuditServices = plan.find_resources("tencentcloud_mysql_audit_service")
violations = {}
for allAuditServices as address, audit_service {
	audit_all = plan.evaluate_attribute(audit_service, "audit_all") else false
	log_expire_day = plan.evaluate_attribute(audit_service, "log_expire_day") else null
	if audit_all is not true or log_expire_day is null or
		log_expire_day < min_audit_log_retention_days {
		msg = address + " does not provide full MySQL audit coverage with " +
			string(min_audit_log_retention_days) +
			" days of retention."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
