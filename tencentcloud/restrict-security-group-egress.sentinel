# restrict-security-group-egress
# Blocks ACCEPT egress rules that expose all ports or sensitive database ports
# to the public internet. Port values use Tencent Cloud's string syntax.

import "tencentcloud-functions" as tc

param forbidden_ports default [3306, 6379, 27017, 1433, 5432]
param unrestricted_cidrs default ["0.0.0.0/0", "::/0"]

all_rules = tc.find_security_group_rules()
violations = {}
for all_rules as key, sg_rule {
	cidr = sg_rule.cidr_block else null
	port = sg_rule.port else null
	action = sg_rule.action else "ACCEPT"

	if action is "ACCEPT" and cidr in unrestricted_cidrs {
		if port is null or tc.port_matches_any(port, [0]) {
			msg = key + " allows egress to " + cidr +
				" on all ports - this is a critical security risk"
			violations[key] = msg
			print(msg)
		} else if tc.port_matches_any(port, forbidden_ports) {
			msg = key + " allows egress to " + cidr + " on " +
				string(port) +
				" - database ports must not be exposed"
			violations[key] = msg
			print(msg)
		}
	}
}

main = rule {
	length(violations) is 0
}
