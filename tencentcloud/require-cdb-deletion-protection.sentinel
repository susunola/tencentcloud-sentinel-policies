# require-cdb-deletion-protection
# Prevents direct deletion of MySQL instances. Tencent Cloud's provider
# exposes force_delete: true bypasses the recycle bin and is not a generic
# deletion_protection flag.

import "tfplan-functions" as plan

allDatabases = plan.find_resources("tencentcloud_mysql_instance")
violations = {}
for allDatabases as address, database {
	force_delete = plan.evaluate_attribute(database, "force_delete") else false
	if force_delete is true {
		msg = address + " enables force_delete=true. " +
			"Production MySQL instances must retain the recycle-bin recovery path."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
