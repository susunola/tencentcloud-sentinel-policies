# validate-provider-regions
# Requires that all TencentCloud providers are configured only for
# approved regions. This prevents accidental resource creation in
# unapproved regions (e.g., outside the organization's designated
# operating zones). Supports both constant values and variable references.

import "tfplan/v2" as tfplan
import "tfconfig/v2" as tfconfig
import "strings"
import "types"

param allowed_regions default [
  "ap-guangzhou",
  "ap-shanghai",
  "ap-beijing",
  "ap-singapore",
]

violations = 0

# Process each provider configuration
for tfconfig.providers as alias, p {
  if not strings.has_prefix(alias, "tencentcloud") {
    continue
  }

  if "config" in keys(p) and "region" in keys(p.config) {
    region_config = p.config.region

    # Handle constant value
    if "constant_value" in keys(region_config) {
      if region_config.constant_value not in allowed_regions {
        print("TencentCloud provider '" + alias + "' uses region '" +
              region_config.constant_value + "' which is not allowed.")
        violations += 1
      }
    }

    # Handle variable references (simple case)
    if "references" in keys(region_config) {
      for region_config.references as ref {
        if strings.has_prefix(ref, "var.") {
          var_name = strings.split(ref, ".")[1]
          val = tfplan.variables[var_name].value else null
          if val is not null and val not in allowed_regions {
            print("TencentCloud provider '" + alias + "' uses region '" +
                  string(val) + "' (from variable " + var_name +
                  ") which is not allowed.")
            violations += 1
          }
        }
      }
    }
  }
}

main = rule {
  violations is 0
}
