# require-cos-logging
# Requires COS access logging with a target bucket.
# Tencent Cloud COS uses log_enable and log_target_bucket; log_set_id is a CLB field.

import "tfplan-functions" as plan

allBuckets = plan.find_resources("tencentcloud_cos_bucket")
violations = {}
for allBuckets as address, bucket {
	log_enable = plan.evaluate_attribute(bucket, "log_enable") else false
	log_target_bucket = plan.evaluate_attribute(bucket, "log_target_bucket") else ""
	if log_enable is not true or log_target_bucket is "" {
		msg = address + " does not configure COS access logging. " +
			"Set log_enable=true and provide log_target_bucket."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
