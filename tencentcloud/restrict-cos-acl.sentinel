# restrict-cos-acl
# Requires the Tencent Cloud COS bucket ACL to remain private.
# Public bucket-policy principals are checked separately by
# restrict-cos-bucket-policy; COS has no AWS-style public_access_block argument.

import "tfplan-functions" as plan

allBuckets = plan.find_resources("tencentcloud_cos_bucket")
violations = {}
for allBuckets as address, bucket {
	acl = plan.evaluate_attribute(bucket, "acl") else "private"
	if acl is not "private" {
		msg = address + " has ACL '" + acl + "'. COS bucket ACL must be 'private'."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
