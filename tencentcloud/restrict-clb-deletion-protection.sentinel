# restrict-clb-deletion-protection
# Requires the Tencent Cloud CLB provider's actual delete_protect attribute.

import "tfplan-functions" as plan

allCLBs = plan.find_resources("tencentcloud_clb_instance")
violations = {}
for allCLBs as address, clb {
	delete_protect = plan.evaluate_attribute(clb, "delete_protect") else false
	if delete_protect is not true {
		msg = address + " does not enable CLB delete protection. " +
			"Set delete_protect=true."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
