# restrict-cam-access-key-age
# Enforces a maximum age for CAM access keys when the provider exposes a
# parseable create_time value in the Terraform plan. The provider conventions
# available in this repository do not establish a reliable key_status field,
# so this policy deliberately does not invent or enforce one.
# Missing or non-RFC3339 create_time values are not rejected; the age check is
# applied only when create_time is present and parseable.

import "tfplan-functions" as plan
import "time"
import "types"

param max_key_age_days default 90

allAccessKeys = plan.find_resources("tencentcloud_cam_access_key")
violations = {}
cutoff = time.now.add(-(time.hour * 24 * max_key_age_days))

for allAccessKeys as address, access_key {
	create_time = plan.evaluate_attribute(access_key, "create_time") else null

	if types.type_of(create_time) is "string" and
		create_time matches "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" {
		created_at = time.load(create_time) else null
		if created_at is not null and created_at.before(cutoff) {
			msg = address + " has a CAM access key older than " +
				string(max_key_age_days) +
				" days. Rotate the key."
			violations[address] = msg
			print(msg)
		}
	}
}

main = rule {
	length(violations) is 0
}
