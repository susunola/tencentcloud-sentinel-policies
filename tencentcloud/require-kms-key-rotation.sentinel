# require-kms-key-rotation
# Requires all KMS keys to have automatic key rotation enabled.
# Rotating encryption keys regularly limits the blast radius of a key
# compromise and is required by most compliance frameworks.

import "tfplan-functions" as plan

allKeys = plan.find_resources("tencentcloud_kms_key")

violations = {}
for allKeys as address, key {
	rotation = plan.evaluate_attribute(key, "key_rotation_enabled") else null
	if rotation is null or rotation is not true {
		msg = address + " does not have automatic key rotation enabled " +
			"(key_rotation_enabled=true). All KMS keys must rotate automatically."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
