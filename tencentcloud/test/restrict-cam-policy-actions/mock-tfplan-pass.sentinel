resource_changes = {
  "tencentcloud_cam_policy.example": {
    "mode": "managed",
    "type": "tencentcloud_cam_policy",
    "change": {
      "actions": ["create"],
      "after": {
        "document": "{\"version\":\"2.0\",\"statement\":[{\"effect\":\"allow\",\"action\":[\"name/GetRole\"],\"resource\":[\"qcs::cam::uin/100000000001:uin/100000000001\"]}]}",
      },
    },
