# require-cbs-encryption
# Requires that all CBS (Cloud Block Storage) disks have encryption enabled.
# Unencrypted block storage is a compliance risk for data at rest.
# This policy enforces encrypt=true on all tencentcloud_cbs_storage resources.

import "tfplan-functions" as plan

allDisks = plan.find_resources("tencentcloud_cbs_storage")

violations = {}
for allDisks as address, disk {
	encrypted = plan.evaluate_attribute(disk, "encrypt") else null
	if encrypted is null or encrypted is not true {
		msg = address + " does not have encryption enabled (encrypt=true). " +
			"All CBS disks must be encrypted at rest."
		violations[address] = msg
		print(msg)
	}
}

main = rule {
	length(violations) is 0
}
